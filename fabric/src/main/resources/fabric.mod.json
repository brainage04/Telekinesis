{
	"schemaVersion": 1,
	"id": "${mod_id}",
	"version": "${mod_version}",
	"name": "${mod_name}",
	"description": "Automatically places player-mined block drops into the player's inventory.",
	"authors": [
		"brainage04"
	],
	"contact": {
		"homepage": "https://github.com/brainage04/Telekinesis",
		"sources": "https://github.com/brainage04/Telekinesis"
	},
	"license": "MIT",
	"icon": "assets/telekinesis/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"io.github.brainage04.telekinesis.fabric.TelekinesisFabric"
		]
	},
	"mixins": [
		"telekinesis.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "~${minecraft_version}",
		"java": ">=${java_version}",
		"fabric-api": "*",
		"brainagelib": ">=${brainagelib_version}"
	}
